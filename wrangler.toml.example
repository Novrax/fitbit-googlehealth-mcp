name = "fitbit-googlehealth-mcp"
main = "src/index.ts"
compatibility_date = "2025-11-01"
compatibility_flags = ["nodejs_compat"]

[vars]
# Anthropic's published outbound CIDR for Claude → MCP server connections.
ALLOWED_CIDRS = "160.79.104.0/21"

# Which backend to serve: "google" (default) or "fitbit".
# The legacy Fitbit Web API is being decommissioned in September 2026; leave
# this on "google" unless you are deliberately testing the old path.
HEALTH_PROVIDER = "google"

# IANA timezone used to resolve "today" for tools with an optional `date`.
# Set this to where you actually live, or every "log this for today" call can
# land on the wrong day. Defaults to UTC when unset.
TIMEZONE = "Europe/London"

# Create both KV namespaces before `wrangler deploy`:
#   wrangler kv namespace create TOKENS
#   wrangler kv namespace create CACHE
# Then paste the returned ids below.

[[kv_namespaces]]
binding = "TOKENS"
id = "<your-tokens-namespace-id>"

[[kv_namespaces]]
binding = "CACHE"
id = "<your-cache-namespace-id>"

# Set the following secrets:
#   wrangler secret put GOOGLE_CLIENT_ID
#   wrangler secret put GOOGLE_CLIENT_SECRET
#   wrangler secret put MCP_SHARED_SECRET   # `openssl rand -hex 32`
#
# Only if HEALTH_PROVIDER = "fitbit":
#   wrangler secret put FITBIT_CLIENT_ID
#   wrangler secret put FITBIT_CLIENT_SECRET
